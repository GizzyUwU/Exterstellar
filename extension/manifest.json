{
  "manifest_version": 3,
  "name": "Exterstellar",
  "version": "0.1.0",
  "description": "Exterstellar is a QoL-focused browser extension for Stardance.",
  "icons": {
    "16": "images/16.png",
    "48": "images/48.png",
    "128": "images/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Exterstellar"
  },
  "content_scripts": [
    {
      "matches": ["https://*.stardance.hackclub.com/*"],
      "js": [
        "plugins/registry.js",
        "plugins/better-sidebar.js",
        "plugins/custom-font.js",
        "plugins/scrollbar.js",
        "plugins/devlog-formatter.js",
        "plugins/sidebar-hotkeys.js",
        "plugins/sidebar-reorder.js",
        "plugins/themes.js",
        "plugins/md-preview.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "exterstellar@extension",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}